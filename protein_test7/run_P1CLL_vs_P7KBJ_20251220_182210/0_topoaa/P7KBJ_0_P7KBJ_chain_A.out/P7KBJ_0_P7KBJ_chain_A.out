 CNSsolve>!for the histidine patches: 
 CNSsolve>if ($autohis = false) then 
 NEXTCD: condition evaluated as false
 CNSsolve>    evaluate($hisd_counter=1) 
 CNSsolve>    while ($hisd_counter le $nhisd) loop hisd 
 CNSsolve>        show (resn) (tag and resid $hisd_$hisd_counter) 
 CNSsolve>        if ($result eq "HIS") then 
 CNSsolve>            patch hisd reference=nil=(resid $hisd_$hisd_counter) end 
 CNSsolve>        end if 
 CNSsolve>        evaluate($hisd_counter=$hisd_counter + 1) 
 CNSsolve>    end loop hisd 
 CNSsolve> 
 CNSsolve>    evaluate($hise_counter=1) 
 CNSsolve>    while ($hise_counter le $nhise) loop hise 
 CNSsolve>        show (resn) (tag and resid $hise_$hise_counter) 
 CNSsolve>        if ($result eq "HIS") then 
 CNSsolve>            patch hise reference=nil=(resid $hise_$hise_counter) end 
 CNSsolve>        end if 
 CNSsolve>        evaluate($hise_counter=$hise_counter + 1) 
 CNSsolve>    end loop hise 
 CNSsolve>end if 
