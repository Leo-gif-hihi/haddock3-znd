 CNSsolve>!if problem detected try correcting it by centering the system around 4500,4500,4500 
 CNSsolve>!but only if no EM restraints are used 
 CNSsolve> 
 CNSsolve>if ($failure eq true) then 
 NEXTCD: condition evaluated as false
 CNSsolve>    if ($data.flags.em eq false) then 
 CNSsolve> 
 CNSsolve>        evaluate ($xc = 0.0) 
 CNSsolve>        evaluate ($yc = 0.0) 
 CNSsolve>        evaluate ($zc = 0.0) 
 CNSsolve>        show ave (x) (all) 
 CNSsolve>        evaluate ($xc = 4500 - $result) 
 CNSsolve>        show ave (y) (all) 
 CNSsolve>        evaluate ($yc = 4500 - $result) 
 CNSsolve>        show ave (z) (all) 
 CNSsolve>        evaluate ($zc = 4500 -$result) 
 CNSsolve> 
 CNSsolve>        do (x = x + $xc) (all) 
 CNSsolve>        do (y = y + $yc) (all) 
 CNSsolve>        do (z = z + $zc) (all) 
 CNSsolve> 
 CNSsolve>        evaluate ($failure = false) 
 CNSsolve>        evaluate ($maxcoor = -999) 
 CNSsolve>        evaluate ($mincoor = 9999) 
 CNSsolve>        !check again for coordinates >9999.999 (max writable in PDB format) 
 CNSsolve>        show max (x) (all) 
 CNSsolve>        evaluate ($maxcoor = $result) 
 CNSsolve>        show max (y) (all) 
 CNSsolve>        if ($result gt $maxcoor) then 
 CNSsolve>            evaluate ($maxcoor = $result) 
 CNSsolve>        end if 
 CNSsolve>        show max (z) (all) 
 CNSsolve>        if ($result gt $maxcoor) then 
 CNSsolve>            evaluate ($maxcoor = $result) 
 CNSsolve>        end if 
 CNSsolve>        if ($maxcoor gt 9999.999) then 
 CNSsolve>            evaluate ($failure = true) 
 CNSsolve>        end if 
 CNSsolve> 
 CNSsolve>        !check for coordinates <-999.999 (min writable in PDB format) 
 CNSsolve>        show min (x) (all) 
 CNSsolve>        evaluate ($mincoor = $result) 
 CNSsolve>        show min (y) (all) 
 CNSsolve>        if ($result lt $mincoor) then 
 CNSsolve>            evaluate ($maxcoor = $result) 
 CNSsolve>        end if 
 CNSsolve>        show min (z) (all) 
 CNSsolve>        if ($result lt $mincoor) then 
 CNSsolve>            evaluate ($mincoor = $result) 
 CNSsolve>        end if 
 CNSsolve>        if ($mincoor lt -999.999) then 
 CNSsolve>            evaluate ($failure = true) 
 CNSsolve>        end if 
 CNSsolve>    end if 
 CNSsolve>end if 
